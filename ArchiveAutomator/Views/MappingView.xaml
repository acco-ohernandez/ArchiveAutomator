<UserControl x:Class="ArchiveAutomator.Views.MappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Job Number column -->
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>  <!-- Status column -->
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>  <!-- Trigger value + Load Jobs -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>   <!-- Label -->
            <ColumnDefinition Width="*"/>     <!-- Input -->
            <ColumnDefinition Width="Auto"/>  <!-- Button (last row) -->
        </Grid.ColumnDefinitions>

        <!-- Job Number Column -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Job Number col:" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                   ItemsSource="{Binding AvailableColumns}"
                   SelectedItem="{Binding SelectedJobNumberColumn}"
                   VerticalContentAlignment="Center"/>

        <!-- Status Column -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Status column:" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                   ItemsSource="{Binding AvailableColumns}"
                   SelectedItem="{Binding SelectedStatusColumn}"
                   VerticalContentAlignment="Center"/>

        <!-- Trigger Value + Load Jobs button -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Trigger value:" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="4" Grid.Column="1"
                   Text="{Binding TriggerValue, UpdateSourceTrigger=PropertyChanged}"
                   VerticalContentAlignment="Center" Padding="4 2"/>
        <Button    Grid.Row="4" Grid.Column="2"
                   Content="Load Jobs"
                   Command="{Binding ParseCommand}"
                   Padding="10 2" Margin="6 0 0 0"/>
    </Grid>
</UserControl>
