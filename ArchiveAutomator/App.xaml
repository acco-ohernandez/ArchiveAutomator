<Application x:Class="ArchiveAutomator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ArchiveAutomator.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ── Converters ──────────────────────────────────────────────────── -->
        <conv:EnumToBoolConverter       x:Key="EnumBoolConverter"/>
        <conv:EnumToVisibilityConverter x:Key="EnumVisibilityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVisibilityConverter"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolVisibilityConverter"/>

        <!-- ── SectionExpander ─────────────────────────────────────────────── -->
        <!--
            A professional collapsible section that replaces GroupBox.
            Usage:  Expander Style="{StaticResource SectionExpander}" Header="Section Title"
            IsExpanded defaults to True (expanded).
        -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="IsExpanded"  Value="True"/>
            <Setter Property="Margin"      Value="0 0 0 8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">

                        <!-- Outer card border -->
                        <Border BorderBrush="#BBBBBB" BorderThickness="1"
                                CornerRadius="4" Background="White"
                                SnapsToDevicePixels="True">
                            <DockPanel>

                                <!-- ── Toggle header button ── -->
                                <ToggleButton DockPanel.Dock="Top"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                              OverridesDefaultStyle="True"
                                              Focusable="False"
                                              Content="{TemplateBinding Header}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd"
                                                    BorderBrush="#BBBBBB" BorderThickness="0 0 0 1"
                                                    CornerRadius="3 3 0 0"
                                                    Padding="10 7"
                                                    Cursor="Hand">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#F5F5F5" Offset="0"/>
                                                        <GradientStop Color="#E8E8E8" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <DockPanel LastChildFill="True">
                                                    <!-- Chevron arrow: points ▶ when collapsed, ▼ when expanded -->
                                                    <Path x:Name="Arrow"
                                                          DockPanel.Dock="Left"
                                                          Margin="0 0 8 0"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 5 4 L 0 8 Z"
                                                          Fill="#555555"
                                                          Stretch="None"
                                                          RenderTransformOrigin="0.5 0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="90"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      TextElement.FontWeight="SemiBold"
                                                                      TextElement.FontSize="12"
                                                                      TextElement.Foreground="#222222"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Collapsed: arrow points right (0°), no bottom border -->
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                                                    <Setter TargetName="Bd" Property="CornerRadius"    Value="3"/>
                                                </Trigger>
                                                <!-- Hover -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#EAF0FF" Offset="0"/>
                                                                <GradientStop Color="#D8E2FF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <!-- Pressed -->
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#D0DAFF" Offset="0"/>
                                                                <GradientStop Color="#BEC8FF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- ── Collapsible content ── -->
                                <ContentPresenter x:Name="ExpandSite"
                                                  Margin="10 8 10 10"
                                                  Focusable="False"/>
                            </DockPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
